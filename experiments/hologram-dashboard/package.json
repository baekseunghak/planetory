{
  "name": "planetory-hologram-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5177 --strictPort",
    "data:prepare": "node scripts/import-observations.mjs",
    "data:check": "node scripts/import-observations.mjs --check",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5177 --strictPort",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
