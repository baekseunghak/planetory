{
  "name": "planetory-galaxy-proposal",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 58241",
    "api": "tsx server/http.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src server tests shared vite.config.ts",
    "test:browser": "npm run test:galaxy",
    "check": "npm run build && npm test && npm run test:browser",
    "dev:local": "vite --host 127.0.0.1 --port 58241 --strictPort",
    "test:galaxy": "playwright test --config playwright.galaxy.config.ts"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
