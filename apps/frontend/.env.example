# /api is proxied only when an actual backend URL is configured.
VITE_API_BASE=/api
API_PROXY_TARGET=
# Default: GET /api/v1/auth/csrf before writes. Cookie/header overrides are optional.
# Never store tokens here. Set both overrides or leave both empty.
VITE_CSRF_HEADER=
VITE_CSRF_COOKIE=
# Optional agreed response header for server correlation IDs (no invented default).
VITE_REQUEST_ID_HEADER=

# S03 provider entry URLs: backend creates state, exchanges code and sets session.
# Configure backend AUTH_SUCCESS_URL=/oauth/callback and register the frontend origin callback.
VITE_OAUTH_SSAFY_URL=/oauth2/authorization/ssafy
VITE_OAUTH_GOOGLE_URL=/oauth2/authorization/google
# Current backend auto-generates the first nickname. Keep this optional gate unset.
# Initial nickname gate: configured error code from GET /v1/me (403/409).
# The path must accept PATCH {nickname}; no assumed production default.
VITE_NICKNAME_REQUIRED_CODE=
VITE_INITIAL_NICKNAME_PATH=

# W06-1 independent renderer integration. Keep disabled until W06-2 controls are connected.
VITE_SKY_RENDERER_ENABLED=false
