# /api is proxied only when an actual backend URL is configured.
VITE_API_BASE=/api
API_PROXY_TARGET=
# S03 / MR !42 default: GET /api/v1/auth/csrf returns headerName + token.
# The client obtains it before each write and does not persist it.
# Leave both below empty for that API. Cookie mode is only for legacy fixtures.
VITE_CSRF_HEADER=
VITE_CSRF_COOKIE=
# MR !42 does not emit a correlation header. Keep empty until the server adds one.
VITE_REQUEST_ID_HEADER=
