{
  "name": "@planetory/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:presentation": "node --import tsx scripts/presentation-server.mjs",
    "data:prepare": "tsx scripts/prepare-observations.ts",
    "dev:observations": "vite --mode observations --host 127.0.0.1 --port 5182 --strictPort",
    "test:observations": "playwright test --config=playwright.observations.config.ts",
    "dev": "vite --host 127.0.0.1",
    "dev:fixture": "vite --mode fixture --host 127.0.0.1 --port 58267 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/check-production.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 58263 --strictPort",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:browser": "playwright test --project=chromium",
    "test:browser:desktop": "playwright test --project=chrome --project=msedge --project=firefox",
    "test:production": "playwright test --config=playwright.production.config.ts",
    "test:performance": "npm run build && playwright test --config=playwright.performance.config.ts",
    "test:gpu": "playwright test --config=playwright.gpu.config.ts",
    "test:gpu:app": "playwright test --config=playwright.gpu-app.config.ts",
    "check": "npm run build && npm test && npm run test:browser && npm run test:auth && npm run test:sky-data && npm run test:galaxy && npm run test:production && npm run test:interaction && npm run test:detail && npm run test:docker-defaults && npm run test:fallback && npm run test:quests && npm run test:community && npm run test:posts && npm run test:comments && npm run test:reactions && npm run test:materials && npm run test:profiles && npm run test:search -- --project=chromium && npm run test:hot-topics -- --project=chromium",
    "format": "prettier --write src dev tests scripts docs *.ts *.json *.html *.md",
    "format:check": "prettier --check src dev tests scripts docs *.ts *.json *.html *.md",
    "dev:auth": "vite --mode auth --host 127.0.0.1 --port 58268 --strictPort",
    "test:auth": "playwright test --config=playwright.auth.config.ts --project=chromium",
    "dev:sky-data": "vite --mode sky-data --host 127.0.0.1 --port 58270 --strictPort",
    "test:sky-data": "playwright test --config=playwright.sky-data.config.ts --project=chromium",
    "dev:galaxy": "vite --mode galaxy --host 127.0.0.1 --port 58272 --strictPort",
    "test:galaxy": "playwright test --config=playwright.galaxy.config.ts --project=chromium",
    "build:renderer": "npm run typecheck && node scripts/build-renderer.mjs && node scripts/check-production.mjs",
    "test:renderer-production": "playwright test --config=playwright.renderer-production.config.ts",
    "dev:interaction": "vite --mode interaction --host 127.0.0.1 --port 58326 --strictPort",
    "test:interaction": "playwright test --config=playwright.interaction.config.ts --project=chromium",
    "test:docker-defaults": "node scripts/test-docker-defaults.mjs",
    "dev:detail": "vite --mode interaction --host 127.0.0.1 --port 58335 --strictPort",
    "test:detail": "playwright test --config=playwright.detail.config.ts --project=chromium",
    "dev:fallback": "vite --mode interaction --host 127.0.0.1 --port 58338 --strictPort",
    "test:fallback": "playwright test --config=playwright.fallback.config.ts --project=chromium",
    "dev:quests": "vite --mode interaction --host 127.0.0.1 --port 58345 --strictPort",
    "test:quests": "playwright test --config=playwright.quests.config.ts --project=chromium",
    "dev:community": "vite --mode community --host 127.0.0.1 --port 58346 --strictPort",
    "test:community": "playwright test --config=playwright.community.config.ts --project=chromium",
    "dev:posts": "vite --mode posts --host 127.0.0.1 --port 58348 --strictPort",
    "test:posts": "playwright test --config=playwright.posts.config.ts --project=chromium",
    "dev:comments": "vite --mode comments --host 127.0.0.1 --port 58350 --strictPort",
    "test:comments": "playwright test --config=playwright.comments.config.ts --project=chromium",
    "dev:reactions": "vite --mode reactions --host 127.0.0.1 --port 58352 --strictPort",
    "test:reactions": "playwright test --config=playwright.reactions.config.ts --project=chromium",
    "dev:materials": "vite --mode materials --host 127.0.0.1 --port 58354 --strictPort",
    "test:materials": "playwright test --config=playwright.materials.config.ts --project=chromium",
    "dev:performance": "node --import tsx scripts/performance-server.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "dev:profiles": "vite --mode profiles --host 127.0.0.1 --port 58356 --strictPort",
    "test:profiles": "playwright test --config=playwright.profiles.config.ts --project=chromium",
    "dev:search": "vite --mode search --host 127.0.0.1 --port 58364 --strictPort",
    "test:search": "playwright test --config=playwright.search.config.ts",
    "dev:hot-topics": "vite --mode hot-topics --host 127.0.0.1 --port 58368 --strictPort",
    "test:hot-topics": "playwright test --config=playwright.hot-topics.config.ts",
    "dev:p1": "node --import tsx scripts/p1-server.mjs",
    "test:p1": "playwright test --config=playwright.p1.config.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
