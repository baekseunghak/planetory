  "recordChecksumVersion": "record-canonical-v0",
  "jira": "S15P21C206-117",
  "status": "proposal-v0-not-team-approved",
  "encoding": {
    "null": "0x00",
    "bool": "0x01 + 1 byte",
    "number": "0x02 + float64 LE (finite only, -0 -> +0, integers as float64)",
    "string": "0x03 + u32 LE byte length + UTF-8",
    "list": "0x04 + u32 LE count + items",
    "object": "0x05 + u32 LE count + (key string, value) sorted by key UTF-8 bytes",
    "collection": "sha256 over list-encoding of prepared records; prepared = exclude fields, then sort by sort_key"
  },
  "rules": {
    "candidates": {
      "exclude": [
        "id",
        "updated_bundle_id",
        "local_key",
        "tic_id"
      ],
      "exclude_nested": [
        "transit_model.candidate_id"
      ],
      "sort_key": [
        "removal_step",
        "period_days",
        "epoch_btjd"
      ]
    },
    "ai_results": {
      "exclude": [
        "id",
        "candidate_id",
        "execution_id"
      ],
      "exclude_nested": [],
      "sort_key": [
        "candidate_key.period_days",
        "candidate_key.epoch_btjd",
        "model_version"
      ]
    },
    "external_statuses": {
      "exclude": [
        "id",
        "candidate_id",
        "tic_id"
      ],
      "exclude_nested": [],
      "sort_key": [
        "source",
        "external_id"
      ]
    }
  },
