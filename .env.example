# Local Compose
POSTGRES_PASSWORD=replace-for-local-use
# Host port only; containers always use service-db:5432. Change if 5432 is taken on your PC.
POSTGRES_PORT=5432
LOCAL_APP_PLATFORM=linux/amd64
LOCAL_DATA_PLATFORM=linux/amd64

# Optional local base-image overrides
HADOOP_IMAGE=apache/hadoop:3.4.3
SPARK_IMAGE=apache/spark:3.5.5-python3
AIRFLOW_IMAGE=apache/airflow:2.10.5-python3.12

# GCP cross-project host aliases for distributed-system Compose
GCP_ZONE=asia-east1-b
GCP_NODE_1_PROJECT=replace-node-1-project
GCP_NODE_2_PROJECT=replace-node-2-project
GCP_NODE_3_PROJECT=replace-node-3-project
GCP_NODE_4_PROJECT=replace-node-4-project
GCP_NODE_5_PROJECT=replace-node-5-project
GCP_NODE_6_PROJECT=replace-node-6-project
