  </property>
  <property>
    <name>dfs.namenode.rpc-address.planetory.nn2</name>
    <value>worker-2:8020</value>
  </property>
  <property>
    <name>dfs.namenode.http-address.planetory.nn1</name>
    <value>master-1:9870</value>
  </property>
  <property>
    <name>dfs.namenode.http-address.planetory.nn2</name>
    <value>worker-2:9870</value>
