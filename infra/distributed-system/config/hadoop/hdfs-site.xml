<?xml version="1.0"?>
<configuration>
  <property>
    <name>dfs.nameservices</name>
    <value>planetory</value>
  </property>
  <property>
    <name>dfs.ha.namenodes.planetory</name>
    <value>nn1,nn2</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address.planetory.nn1</name>
